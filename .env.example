# ─── AI Health Check: /api/assessment Environment Variables ──────────────────
# ⚠️  IMPORTANT: These go in Vercel Dashboard → Project Settings → Environment Variables
#    DO NOT add these to any frontend files, .env files, or commit to git
#
# Required for Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# The Google Sheet ID where submissions will be written
# Found in the Google Sheet URL: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEETS_ID}/edit
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Resend API Key for sending emails
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Owner notification email (receives all submission alerts)
OWNER_EMAIL=homebox997@gmail.com

# From address for outgoing emails (must be verified in Resend)
FROM_EMAIL=hello@agedpawwell.com
