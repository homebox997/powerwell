{
  "buildCommand": "echo 'Static HTML - no build needed'",
  "outputDirectory": ".",
  "installCommand": "echo 'No dependencies - static site'",
  "framework": null,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Config-Test", "value": "applied" }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog.html", "destination": "/AU/blog.html", "permanent": true },
    { "source": "/blog/(.*)", "destination": "/AU/blog/$1", "permanent": true },
    { "source": "/heart.html", "destination": "/AU/heart.html", "permanent": true },
    { "source": "/kidney.html", "destination": "/AU/kidney.html", "permanent": true },
    { "source": "/arthritis.html", "destination": "/AU/arthritis.html", "permanent": true },
    { "source": "/assessment.html", "destination": "/AU/assessment.html", "permanent": true },
    { "source": "/community.html", "destination": "/AU/community.html", "permanent": true },
    { "source": "/submit.html", "destination": "/AU/submit.html", "permanent": true }
  ]
}
